# Neon / PostgreSQL connection. Prefer the pooled Neon URL (hostname contains "-pooler").
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optional: use this instead of NEON_DATABASE_URL
# JR_ESCALA_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Optional overrides
JR_ESCALA_DB_SSLMODE=require
JR_ESCALA_DB_CONNECT_TIMEOUT=10
JR_ESCALA_DB_CONNECT_ATTEMPTS=3
JR_ESCALA_DB_POOL=1
JR_ESCALA_DB_POOL_MAX=4
JR_ESCALA_UPLOAD_DIR=./web/uploads
JR_ESCALA_REPORTS_DIR=./web/reports
